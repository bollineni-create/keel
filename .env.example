# Anthropic API key for the built-in assistant (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model for the assistant
KEEL_MODEL=claude-sonnet-5-5
# Port to serve the app + MCP endpoint
PORT=4242
# Bind address. 0.0.0.0 lets your phone reach it over LAN/Tailscale.
HOST=0.0.0.0
# Optional shared secret. If set, the web app, /api and /mcp require it
# (Authorization: Bearer <token>, or ?token= once in the browser).
KEEL_TOKEN=
# How to launch the Copilot Money data server. Default uses npx.
# Add --live-reads for fresh GraphQL reads, --write to push edits back to Copilot
# (both need a browser logged in to app.copilot.money).
COPILOT_MCP_COMMAND=npx
COPILOT_MCP_ARGS=-y copilot-money-mcp
# Turn Copilot off once bank connections replace it (on | off)
KEEL_COPILOT=on

# --- Direct bank connections (Settings → Bank connections, or Accounts → Add account) ---
# Plaid: sign up at https://dashboard.plaid.com, apply for the free Trial plan (10 bank logins,
# lifetime), then use the Production keys with PLAID_ENV=production. Try it with sandbox keys first:
# every real link uses a Trial slot even if you remove it later.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Only if a bank's sign-in needs it (phones, some OAuth banks): an HTTPS URL registered with Plaid
PLAID_REDIRECT_URI=
# SimpleFIN needs nothing here: paste a Setup Token from https://beta-bridge.simplefin.org in the app.
# Connection secrets are encrypted with a key kept outside the repo
# (~/Library/Application Support/Keel/secret.key). Set this instead to supply your own 64-hex-char key.
KEEL_SECRET_KEY=
# With bank connections and no KEEL_TOKEN, Keel only answers this Mac. Extra Host names to allow:
KEEL_ALLOWED_HOSTS=

# Sync automatically every N minutes (0 = manual only). SimpleFIN connections sync at most every 4 h.
KEEL_SYNC_MINUTES=30
# SQLite file
KEEL_DB=./data/keel.db
