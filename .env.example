# Anthropic API key for the built-in assistant (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model for the assistant
KEEL_MODEL=claude-sonnet-5-5
# Port to serve the app + MCP endpoint
PORT=4242
# Bind address. 0.0.0.0 lets your phone reach it over LAN/Tailscale.
HOST=0.0.0.0
# Optional shared secret. If set, the web app, /api and /mcp require it
# (Authorization: Bearer <token>, or ?token= once in the browser).
KEEL_TOKEN=
# How to launch the Copilot Money data server. Default uses npx.
# Add --live-reads for fresh GraphQL reads, --write to push edits back to Copilot
# (both need a browser logged in to app.copilot.money).
COPILOT_MCP_COMMAND=npx
COPILOT_MCP_ARGS=-y copilot-money-mcp
# Sync automatically every N minutes (0 = manual only)
KEEL_SYNC_MINUTES=30
# SQLite file
KEEL_DB=./data/keel.db
